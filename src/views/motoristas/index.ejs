<h1>Motoristas</h1>

<p>
  <a href="/motoristas/novo">Novo motorista</a>
</p>

<% if (motoristas.length === 0) { %>
  <p>Nenhum motorista cadastrado.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>CPF</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% motoristas.forEach((motorista) => { %>
        <tr>
          <td><%= motorista.id %></td>
          <td><%= motorista.nome %></td>
          <td><%= motorista.cpf %></td>
          <td><%= motorista.status %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>